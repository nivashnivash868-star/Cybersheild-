# Copy to .env (never commit it). Every value here is read by the app.

# --- Required -------------------------------------------------------------------------------------
# 32+ random characters: signs audit-log hashes and CSRF tokens, encrypts TOTP secrets.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later invalidates sessions, MFA enrolments and audit-chain verification.
SECRET_KEY=
POSTGRES_PASSWORD=

# First Super Admin, created only while the users table is empty. The password must be changed at first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Deployment -------------------------------------------------------------------------------------
ENVIRONMENT=production            # production | staging | development
PUBLIC_BASE_URL=http://localhost:8000   # used in password-reset links
# DATABASE_URL is set by docker-compose; set it yourself when running without compose (postgresql://...).

# --- Alerts: email (SMTP) ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@your-company.com
SMTP_SECURITY=starttls            # starttls | ssl | none

# --- Alerts: SMS (Twilio) ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=               # E.164, e.g. +15551234567

# Where SOC alerts go. JSON lists. SMS is sent for Critical alerts only.
ALERT_SOC_EMAILS=["soc@your-company.com"]
ALERT_SOC_SMS=[]

# --- Blocklist --------------------------------------------------------------------------------------
# Extra ranges/domains that can never be blocked (your own ranges and partner domains), as a JSON list.
BLOCKLIST_PROTECTED=[]
BLOCKLIST_DEFAULT_TTL_HOURS=24

# --- Sessions and login protection (defaults shown) -------------------------------------------------
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# MFA is required for Super Admin, Security Administrator and SOC Analyst outside development.

# --- Local development only -------------------------------------------------------------------------
# DEMO_MODE=true seeds fabricated incidents and known demo passwords. It is refused when ENVIRONMENT=production.
# SQLITE_URL=sqlite:///./dev.db

# --- Zetaris (federated data sources; see docs/zetaris-schema.md) -------------------------------------
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
# Alternative to the API key:
# ZETARIS_USERNAME=admin@zetaris.com
# ZETARIS_PASSWORD=Zetaris1@
ZETARIS_TABLE_AUTH=cybershield.auth_logs
ZETARIS_TABLE_NETWORK=cybershield.network_flows
ZETARIS_TABLE_EMAIL=cybershield.email_logs
# Auth outcome spellings in your table (compared without regard to case). Windows event logs: 4625 / 4624.
# ZETARIS_AUTH_FAILURE_VALUES=FAILURE,FAILED,FAIL
# ZETARIS_AUTH_SUCCESS_VALUES=SUCCESS,SUCCEEDED,OK
# Mark everything read from Zetaris as SIMULATED (set true only for generated test data).
# ZETARIS_DATA_IS_SYNTHETIC=false

# --- Detection tuning (see docs/detection-evaluation.md) ---------------------------------------------
# IPs/CIDRs the network rules ignore for large uploads (backup targets, update servers), comma-separated.
# NETWORK_TRUSTED_DESTINATIONS=52.95.110.0/24
# CSV of your ordinary flows (columns dst_port,bytes,packets) to fit the anomaly model on instead of the generated baseline.
# NETWORK_BASELINE_CSV=/data/flows-baseline.csv
# Text file of known-bad md5/sha256 hashes (one per line, optional ",name"), e.g. a MalwareBazaar export.
# FILE_HASH_FEED_PATH=/data/bad-hashes.txt

# --- Threat intelligence (docs/integration-testing.md) ---------------------------------------------
# Only public IPs, domains and file hashes are sent; results are cached.
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# TI_SEND_FULL_URLS=false

# --- Single sign-on, OpenID Connect (docs/sso.md) ----------------------------------------------------
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Microsoft
# OIDC_ALLOWED_EMAIL_DOMAINS=your-company.com
# OIDC_IDP_ENFORCES_MFA=false
# PUBLIC_BASE_URL=https://cybershield.your-company.com

# --- Response connector: identity provider / EDR actions (docs/response-connector.md) --------------------
# RESPONSE_WEBHOOK_URL=https://soar.your-company.com/hooks/cybershield
# RESPONSE_WEBHOOK_SECRET=            # 32+ random characters, shared with the receiver
# RESPONSE_WEBHOOK_ACTIONS=DISABLE_ACCOUNT,HOST_ISOLATION
