# CYBERSHIELD AI — SOC Platform Environment Configuration Sample
# Copy to .env and adjust variables as needed

# Database: Set your Supabase PostgreSQL connection string if available.
# Example: postgresql://postgres.xxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# If left empty, CYBERSHIELD automatically operates with local high-performance SQLite SOC cache.
SUPABASE_DATABASE_URL=

# External Threat Intelligence Reputation APIs (Optional)
# If left empty, CYBERSHIELD operates with trained offline Scikit-Learn NLP models and heuristic rule engines.
VIRUSTOTAL_API_KEY=
PHISHTANK_API_KEY=
ABUSEIPDB_API_KEY=

# Security & JWT Authentication
ENVIRONMENT=development
SECRET_KEY=cybershield-soc-secret-development-key-change-in-production
JWT_SECRET_KEY=cybershield-enterprise-jwt-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Automated Alerting & Notification Providers (Optional)
# If unconfigured, notifications are safely recorded in the audit trail and displayed in-app.
ALERT_EMAIL_ENABLED=true
ALERT_SMS_GATEWAY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Enterprise Web Gateway & DNS Firewall (Optional)
# If unconfigured, interstitial safe-mode is enforced with employee override logging.
GATEWAY_BLOCKING_INTEGRATION_URL=
CISCO_UMBRELLA_API_KEY=
PALO_ALTO_PANOS_API_KEY=
